<!--
  Wazuh decoder for bastion audit log (syslog tag = bastion-audit, JSON payload)
  Sample: May 19 02:05 bastion bastion-audit {"id": 328, "course": "secuops", ...}
-->
<decoder name="bastion-audit">
  <prematch>bastion-audit </prematch>
  <plugin_decoder offset="after_prematch">JSON_Decoder</plugin_decoder>
</decoder>
